# ── Dados de entrada (confidenciais — nunca versionar) ──────────────────────
data/*.xlsx
data/*.xls
data/*.csv
!data/correspondencia.csv
!data/.gitkeep

# ── Outputs gerados ──────────────────────────────────────────────────────────
output/*.xlsx
output/*.csv
output/*.xls
!output/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Ambientes virtuais ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Sistema operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
